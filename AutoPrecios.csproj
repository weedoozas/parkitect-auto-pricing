<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mod de Parkitect: compila contra las DLL del propio juego (Mono de Unity),
       sin paquetes de NuGet. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>AutoPrecios</AssemblyName>
    <RootNamespace>AutoPrecios</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <GameManaged Condition="'$(GameManaged)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Parkitect/Parkitect_Data/Managed</GameManaged>
    <ModFolder Condition="'$(ModFolder)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Parkitect/Mods/AutoPrecios</ModFolder>
  </PropertyGroup>

  <!-- Copia de prueba: otro ensamblado y otro identificador, para instalarla junto a la versión
       del Workshop sin tocarla (`dotnet build -c Beta -p:InstallMod=true`). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Beta'">
    <AssemblyName>AutoPreciosBeta</AssemblyName>
    <DefineConstants>$(DefineConstants);BETA</DefineConstants>
    <ModFolder>$(HOME)/.local/share/Steam/steamapps/common/Parkitect/Mods/AutoPrecios-beta</ModFolder>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(GameManaged)/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="netstandard"><HintPath>$(GameManaged)/netstandard.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(GameManaged)/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(GameManaged)/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Parkitect"><HintPath>$(GameManaged)/Parkitect.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(GameManaged)/UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copia la DLL a la carpeta de mods del juego al compilar. -->
  <Target Name="InstalarMod" AfterTargets="Build" Condition="'$(InstallMod)' == 'true'">
    <MakeDir Directories="$(ModFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModFolder)" />
  </Target>

</Project>
